# ===================================================================
# AI Bill Scanner & Expense Manager - Backend Environment Template
# ===================================================================

# 1. AI Provider Selection
# Options: "mock" (offline test mode) or "gemini" (Google Gemini AI OCR)
AI_PROVIDER=mock

# 2. Google Gemini API Key (Required only if AI_PROVIDER=gemini)
# Get a free key from https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# 3. Application Security & Database
DEBUG=False
SECRET_KEY=change-this-to-a-secure-random-string-in-production

# Database URL
# Local SQLite default:
DATABASE_URL=sqlite:///./bill_intelligence.db
# Or PostgreSQL for cloud production (e.g., Supabase / Neon / Render PostgreSQL):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Storage
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=uploads

# CORS Allowed Origins
# Comma-separated list of allowed frontend URLs
# In production, set to your Vercel URL (e.g. https://your-project.vercel.app)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
